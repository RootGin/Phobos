(defvar revealpowermenu false)
(defvar powermenu-button-hovered false)
(defvar powermenu-button-selected "")
(defvar powermenu-status "")
(defvar bunny-head "( . .) ")
(defvar screen-locked false)
(defvar screen-lock-password "shine")   ; hardcoded lock password
(defvar screen-lock-input "")
(defvar screen-lock-input-masked "")
(defvar screen-lock-input-last-action "clear")
(defvar screen-lock-auth-failed false)

(defvar power-can-poweroff true)
(defvar power-can-reboot true)
(defvar power-can-suspend true)
(defvar power-can-hibernate true)
(defvar power-can-exit true)
(defvar power-can-lock true)
(defvar power-reason-suspend "")
(defvar power-reason-hibernate "")

(defpoll pm-info
  :initial '{"greeting":"HELLO,","user":"USER","os":"NixOS","cpu":"CPU","ram":"0 GiB","batt":"000","segments":[]}'
  :interval "30s"
  :run-while revealpowermenu
  "./scripts/helper/powermenu-info.py")

(defpoll power-caps :initial "ok" :interval "5s" :run-while revealpowermenu "./scripts/helper/check-power-capabilities.sh")

(defwidget pm-spec [icon info]
  (box
    :class "pm-spec"
    :orientation "h"
    :space-evenly false
    (image :class "pm-spec-ico" :image-width 20 :path "./assets/icons/${icon}.svg")
    (label :class "pm-spec-text" :text info)))

(defwidget powermenu-row [extra-class symbol title subtitle cap reason]
  (eventbox
    :onhover "(sleep 0.02 && ${EWW_CMD} update powermenu-button-hovered=true; ./scripts/helper/do-powermenu-action.sh ${extra-class}) &"
    :onhoverlost "${EWW_CMD} update powermenu-button-hovered=false powermenu-button-selected= powermenu-status="
    :onclick "./scripts/helper/do-powermenu-action.sh ${extra-class} click &"
    :cursor {cap ? "hand2" : "not-allowed"}
    :tooltip {cap ? '' : reason}
    (box
      :class "pm-action ${extra-class} ${(powermenu-button-selected == extra-class) ? 'this-selected' : (powermenu-button-selected == '') ? 'nothing-selected' : 'not-selected'}${cap ? '' : ' disabled'}"
      :orientation "h"
      :space-evenly false
      :hexpand true
      (box
        :class "pm-action-disc"
        (image :class "pm-action-icon" :image-width 30 :path "./assets/icons/${symbol}.svg"))
      (box
        :class "pm-action-txt"
        :orientation "v"
        :space-evenly false
        :hexpand true
        (label :class "pm-action-label" :xalign 0 :text title)
        (label :class "pm-action-sub" :xalign 0 :text subtitle))
      (label :class "pm-action-chev" :text ">"))))

(defwindow powermenu
  :geometry (geometry
              :x 0
              :y 0
              :width "100%"
              :height "100%"
              :anchor "center")
  :stacking "overlay"
  :exclusive false
  :focusable "exclusive"
  :namespace "phobos-powermenu"
  :monitor '["<primary>", 0]'
  (overlay
    (revealer
      :transition "crossfade"
      :reveal revealpowermenu
      :duration "300ms"
      (eventbox
        :halign "fill"
        :valign "fill"
        :onclick "${powermenu-button-hovered == false && !screen-locked ? './scripts/powermenu.sh hide &' : 'true'}"
        :onmiddleclick "${!screen-locked ? './scripts/powermenu.sh hide &' : 'true'}"
        :class "powermenu ${screen-locked ? 'locked' : ''}"
        (box
          :class "pm-stage"
          :orientation "h"
          :space-evenly false
          :halign "center"
          :valign "center"

          (box
            :class "pm-card pm-left"
            :orientation "v"
            :space-evenly false
            (box
              :class "pm-cardhead"
              :orientation "h"
              :space-evenly false
              (label :class "pm-head-brand" :text "FOBOS")
              (label :class "pm-head-title" :text "// POWER MENU")
              (box :class "pm-head-rule" :hexpand true :valign "center")
              (label :class "pm-head-slash" :text "///"))
            (box
              :class "pm-left-body"
              :orientation "h"
              :space-evenly false
              :vexpand true
              (box
                :class "pm-left-col"
                :orientation "v"
                :space-evenly false
                :spacing 14
                :hexpand true
                (box
                  :class "pm-greet"
                  :orientation "v"
                  :space-evenly false
                  :spacing 2
                  (label :class "pm-greet-hi" :xalign 0 :text "${pm-info.greeting}")
                  (label :class "pm-greet-name" :xalign 0 :text "${pm-info.user}_"))
                (box
                  :class "pm-subs"
                  :orientation "v"
                  :space-evenly false
                  :spacing 2
                  (label :class "pm-sub" :xalign 0 :text "Another day, another step")
                  (label :class "pm-sub" :xalign 0 :text "towards a better tomorrow."))
                (box :class "pm-shortrule" :halign "start")
                (box
                  :class "pm-specs"
                  :orientation "h"
                  :space-evenly false
                  (pm-spec :icon "spec-os" :info "${pm-info.os}")
                  (label :class "pm-spec-sep" :text "//")
                  (pm-spec :icon "spec-cpu" :info "${pm-info.cpu}")
                  (label :class "pm-spec-sep" :text "//")
                  (pm-spec :icon "spec-ram" :info "${pm-info.ram}"))
                (box :vexpand true)
                (box
                  :class "pm-wordmark"
                  :orientation "h"
                  :space-evenly false
                  (label :class "pm-word-a" :text "FO")
                  (label :class "pm-word-b" :text "BOS")
                  (label :class "pm-word-tm" :text "™")))
              (box
                :class "pm-view"
                :orientation "v"
                :space-evenly false
                :vexpand true
                (box
                  :class "pm-view-in"
                  :orientation "v"
                  :space-evenly false
                  :hexpand true
                  :vexpand true
                  (overlay
                    :vexpand true
                    (box
                      :class "pm-bunny-wrap"
                      :orientation "v"
                      :space-evenly false
                      :vexpand true
                      :halign "center"
                      :valign "center"
                      (box :class "pm-bunny-top" :vexpand true)
                      (eventbox
                        :onhover "${EWW_CMD} update bunny-head='( ^ ^) '"
                        :onhoverlost "${EWW_CMD} update bunny-head='( . .) '"
                        (box
                          :class "pm-bunny"
                          :orientation "v"
                          :space-evenly false
                          :spacing 20
                          :halign "center"
                          (label :text "(\\\\ /)")
                          (label :text "${bunny-head}")
                          (label :class "pm-bunny-feet" :text "c(\")(\")")))
                      (box :vexpand true))
                    (box :class "pm-brk tl" :halign "start" :valign "start")
                    (box :class "pm-brk tr" :halign "end" :valign "start")
                    (box :class "pm-brk bl" :halign "start" :valign "end")
                    (box :class "pm-brk br" :halign "end" :valign "end"))
                  (box
                    :class "pm-batt-wrap"
                    (overlay
                      :class "pm-batt"
                      (box
                        :class "pm-batt-hold"
                        :orientation "v"
                        :space-evenly false
                        (box :vexpand true)
                        (box
                          :class "pm-batt-segs"
                          :orientation "h"
                          :space-evenly false
                          :valign "end"
                          (for seg in {pm-info.segments}
                            (box :class "pm-seg ${seg}"))))
                      (overlay
                        :class "pm-batt-cap"
                        :halign "end"
                        :valign "end"
                        (box :class "pm-cap-tri")
                        (label :class "pm-batt-num" :halign "end" :valign "end" :text "${pm-info.batt}"))))))))

          (box :class "pm-gap")

          (box
            :class "pm-card pm-right"
            :orientation "v"
            :space-evenly false
            (box
              :class "pm-cardhead"
              :orientation "h"
              :space-evenly false
              (image
                :class "pm-head-ico"
                :image-width 22
                :path {screen-locked ? "./assets/icons/pm-lock.svg" : "./assets/icons/settings.svg"})
              (label :class "pm-head-title" :text {screen-locked ? "SYSTEM LOCK" : "QUICK ACTIONS"})
              (box :class "pm-head-rule" :hexpand true :valign "center")
              (label :class "pm-head-slash" :text "///"))
            (box
              :class "pm-actions"
              :orientation "v"
              :space-evenly false
              :hexpand true
              :vexpand true
              :visible {!screen-locked}
              (powermenu-row :extra-class "poweroff" :symbol "pm-poweroff" :title "SHUT DOWN" :subtitle "Power off your system." :cap {power-can-poweroff} :reason "")
              (powermenu-row :extra-class "reboot" :symbol "pm-reboot" :title "RESTART" :subtitle "Restart your system." :cap {power-can-reboot} :reason "")
              (powermenu-row :extra-class "suspend" :symbol "pm-suspend" :title "SLEEP" :subtitle "Put your system to sleep." :cap {power-can-suspend} :reason {power-reason-suspend})
              (powermenu-row :extra-class "hibernate" :symbol "pm-hibernate" :title "HIBERNATE" :subtitle "Hibernate your system." :cap {power-can-hibernate} :reason {power-reason-hibernate})
              (powermenu-row :extra-class "exit" :symbol "pm-exit" :title "LOG OUT" :subtitle "Sign out from your session." :cap {power-can-exit} :reason "")
              (powermenu-row :extra-class "lock" :symbol "pm-lock" :title "LOCK" :subtitle "Lock your screen." :cap {power-can-lock} :reason ""))
            (box
              :class "pm-lock"
              :orientation "v"
              :space-evenly false
              :halign "fill"
              :vexpand true
              :visible {screen-locked}
              (box
                :class "pm-lock-body"
                :orientation "v"
                :space-evenly false
                :halign "center"
                :valign "center"
                :vexpand true
                (box
                  :class "pm-lock-ring ${screen-lock-input-last-action}"
                  (image
                    :image-width 64
                    :path {screen-lock-auth-failed ? "./assets/icons/pm-denied.svg" : "./assets/icons/pm-lock.svg"}))
                (box
                  :class "pm-lock-line"
                  :orientation "h"
                  :space-evenly false
                  (label :class "pm-lock-prompt" :text "> ")
                  (label :text "${screen-lock-input-masked}")
                  (box :class "blink" (label :text "_"))))
              )
            (box
              :class "pm-foot"
              :orientation "h"
              :space-evenly false
              (label :class "pm-foot-key" :text "ESC")
              (label :class "pm-foot-sep" :text "|")
              (label :class "pm-foot-lbl" :text "CANCEL"))
            )
          )
    )
    )
  (box
    :class "pm-keybuf"
    :halign "start"
    :valign "start"
      (label :visible false :text "${inputpipe}")
      (input
        :class "pm-keys"
        :onchange "./scripts/helper/input-controller.sh change '{}'"
        :onaccept "./scripts/helper/input-controller.sh submit '{}'"))))
