(defvar revealsystemint false)
(defvar sysect 0)

(defwindow systemint 
  :geometry (geometry
              :x 0 
              :y -63 
              :width 0
              :height 70
              :anchor "bottom right")
  :stacking "overlay"
  :exclusive false 
  :focusable "ondemand"
  :monitor '["<primary>", 0]'
  (box 
    :orientation "v"
    :space-evenly false 
    :height 70
    (revealer 
      :halign "end"
      :reveal revealsystemint
      :transition "slideleft"
        (box 
          :orientation "v"
          :space-evenly false
          :style "margin-left: 20px;"

          (box 
            :height 20
            :orientation "h"
            :space-evenly false 
            (box 
              :orientation "v"
              :space-evenly false 
              (box 
                :class "triangle bottomright")
              (box 
                :class "window"
                :vexpand true))
            (box 
              :class "window"
              :hexpand true))

          (box
            :class "window"
            (box 
              :style "margin: -20px 0px;"
              (systemwid)))))

    (bottomrightstruct)))
          

(defwidget systemwid []
  (box 
    :orientation "v"
    :space-evenly false 
    :width 404
    :vexpand true 
    :class "window cont trans"
    (sysecthead)
    (sysectbody)
    (slidectl
      :icon {volumejson.volumemute ? "./assets/icons/volumemute.svg" : "./assets/icons/volume.svg"}
      :val "${volumejson.volume}"
      :name "Volume"
      :headclick ""
      :headtip "Volume"
      :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%")
    (slidectl
      :icon {nightlight == "true" ? "./assets/icons/moon.svg" : (brightness < 34 ? "./assets/icons/br-low.svg" : (brightness > 66 ? "./assets/icons/br-high.svg" : "./assets/icons/br-mid.svg"))}
      :val brightness
      :name "Brightness"
      :headclick "setsid -f /home/rootgin/.config/eww/Phobos-dev/scripts/nightlight.sh toggle"
      :headtip {nightlight == "true" ? "Night light on (4000K) — click to turn off" : "Night light off — click to turn on"}
      :onchange "brightnessctl set {}%")
    (wifinav 
      :icon {wifi.connected ? "./assets/icons/wifi.svg" : (wifi.state == "airplane-mode" || wifi.state == "no-interface" ? "./assets/icons/wifioff.svg" : "./assets/icons/wifi.svg")}
      :label {wifi.connected ? wifi.ssid : "Wifi"}
      :state {wifi.state}
      :on {wifi.radio == "enabled"})
    (btnav
      :label {btsec.powered ? "Bluetooth" : "Bluetooth off"}
      :on {btsec.powered})
    (profilectl
      :icon {powerprofile == "power-saver" ? "./assets/icons/pp-save.svg" : (powerprofile == "performance" ? "./assets/icons/pp-perf.svg" : "./assets/icons/pp-balance.svg")}
      :val {powerprofile == "power-saver" ? 0 : (powerprofile == "performance" ? 2 : 1)}
      :auto powerauto
      :name {powerprofile == "power-saver" ? "Reactor sleep" : (powerprofile == "performance" ? "Razgon" : "Stabilization")}
      :command "setsid -f /home/rootgin/.config/eww/Phobos-dev/scripts/powerprofile.sh auto")
    (togglectl 
      :icon "./assets/icons/bell.svg"
      :val {dnd == "false"} 
      :name "Notifications"
      :command "setsid -f /home/rootgin/.config/eww/Phobos-dev/scripts/endctl.sh dnd-toggle")))

(defwidget sysecthead []
  (box
    :class "window cont"
    :orientation "h"
    :space-evenly false
    (image
      :image-width 35
      :path "./assets/icons/sliders.svg")
    (label
      :text {sysect == 0 ? "Section 0" : (sysect == 1 ? "Section 1" : "Section 2")})
    (box
      :hexpand true)
    (eventbox
      :cursor "pointer"
      :onclick "${EWW_CMD} update sysect=${(sysect + 2) % 3} & sleep 0.2; ./scripts/sysstat-poll.sh --once; ./scripts/vpn.py status; ./scripts/zerotier.py status; ./scripts/netbird.py status"
      (image
        :image-width 25
        :path "./assets/icons/chevron-left.svg"))
    (eventbox
      :cursor "pointer"
      :onclick "${EWW_CMD} update sysect=${(sysect + 1) % 3} & sleep 0.2; ./scripts/sysstat-poll.sh --once; ./scripts/vpn.py status; ./scripts/zerotier.py status; ./scripts/netbird.py status"
      (image
        :image-width 25
        :path "./assets/icons/chevron-right.svg"))))

(defwidget statrow [icon name value]
  (box
    :class "starrow"
    :orientation "h"
    :space-evenly false
    (image
      :image-width 24
      :path icon)
    (label
      :class "statname"
      :text name)
    (box
      :hexpand true
      :valign "center"
      (overlay
        (box
          :class "starrow-track"
          :style "background-image: linear-gradient(to right, currentColor 0%, currentColor ${value}%, transparent ${value}%, transparent 100%);")
        (box
          :halign "start"
          :valign "start"
          :class "triangle topleft")
        (box
          :halign "end"
          :valign "end"
          :class "triangle bottomright")))
    (label
      :class "hard"
      :xalign 1
      :text "${value}%")))

(defwidget sysectstat []
  (box
    :class "window cont"
    :orientation "v"
    :space-evenly false
    (statrow
      :icon "./assets/icons/spec-cpu.svg"
      :name "CPU"
      :value "${sysstat.cpu}")
    (statrow
      :icon "./assets/icons/spec-ram.svg"
      :name "RAM"
      :value "${sysstat.ram}")
    (statrow
      :icon "./assets/icons/spec-os.svg"
      :name "Disk"
      :value "${diskstat}")))

(defwidget vpnrow []
  (box
    :class "starrow"
    :orientation "h"
    :space-evenly false
    (image
      :image-width 24
      :path "./assets/icons/shield.svg")
    (label
      :class "statname"
      :xalign 0
      :text "VPN")
    (label
      :class "vpnt-state ${vpnt.state}"
      :xalign 0
      :truncate true
      :limit-width 15
      :text {vpnt.state == "connected" && vpnt.server != "" ? vpnt.server : (vpnt.state == "connected" ? "Connected" : (vpnt.state == "off" ? "Off" : "Disconnected"))})
    (box
      :hexpand true)
    (eventbox
      :cursor "pointer"
      :visible {vpnt.state != "off"}
      :timeout "10s"
      :tooltip {vpnt.state == "connected" ? "Disconnect from the Proton VPN server" : "Connect to the fastest Proton VPN server"}
      :onclick {vpnt.state == "connected" ? "./scripts/vpn.py disconnect &" : "./scripts/vpn.py connect &"}
      (box
        :class "vpnbtn"
        :valign "center"
        (image
          :image-width 18
          :valign "center"
          :path {vpnt.state == "connected" ? "./assets/icons/unlink.svg" : "./assets/icons/link.svg"})))
    (eventbox
      :cursor "pointer"
      :timeout "10s"
      :tooltip {vpnt.state == "off" ? "Turn the Proton VPN integration on" : "Disconnect and turn the Proton VPN integration off"}
      :onclick {vpnt.state == "off" ? "./scripts/vpn.py toggle &" : "./scripts/vpn.py exit &"}
      (box
        :class "switch ${vpnt.state == 'off' ? 'off' : 'on'}"
        (box
          :width 24
          :class "knob")))))

(defwidget sysectbody []
  (box
    :class "window cont"
    :orientation "v"
    :space-evenly false
    :height 128
    (box
      :visible {sysect == 0}
      (sysectstat))
    (box
      :visible {sysect == 1}
      (box
        :class "window cont"
        :orientation "v"
        :space-evenly false
        (vpnrow)
        (nbrow)
        (ztrow)))
    (box
      :visible {sysect == 2}
      (label
        :text "Section 2"))))

(defwidget btnav [label on]
  (box
    :class "window cont btnav"
    :orientation "h"
    :space-evenly false
    (eventbox
      :cursor "pointer"
      :hexpand true
      :timeout "10s"
      :tooltip "Open the Bluetooth manager"
      :onclick "./scripts/hackslide.sh systemint close & ${EWW_CMD} open btpanel &"
      (box
        :orientation "h"
        :space-evenly false
        (image
          :image-width 35
          :path "./assets/icons/bluetooth.svg")
        (label :truncate true :limit-width 14 :text label)))
    (box
      :hexpand true)
    (eventbox
      :cursor "pointer"
      :timeout "10s"
      :tooltip {on ? "Turn Bluetooth off" : "Turn Bluetooth on"}
      :onclick {on ? "./scripts/btsec.py power off &" : "./scripts/btsec.py power on &"}
      (overlay
        (box
          :class "switch ${on ? 'on' : 'off'}"
          (box :width 30 :class "knob"))
        (box :halign "start" :valign "start" :style "margin: 4px;" :class "triangle topleft")
        (box :halign "end" :valign "end" :style "margin: 4px;" :class "triangle bottomright")))))

(defwidget wifinav [icon label state on]
  (box
    :class "window cont wifinav ${state}"
    :orientation "h"
    :space-evenly false
    (eventbox
      :cursor "pointer"
      :hexpand true
      :onclick "./scripts/hackslide.sh systemint close & ${EWW_CMD} open network &"
      (box
        :orientation "h"
        :space-evenly false
        (image :image-width 35 :path icon)
        (label :truncate true :limit-width 20 :text label)))
    (box
      :hexpand true)
    (eventbox
      :cursor "pointer"
      :onclick {on ? "nmcli radio wifi off" : "nmcli radio wifi on"}
      (overlay
        (box
          :class "switch ${on ? 'on' : 'off'}"
          (box :width 30 :class "knob"))
        (box :halign "start" :valign "start" :style "margin: 4px;" :class "triangle topleft")
        (box :halign "end" :valign "end" :style "margin: 4px;" :class "triangle bottomright")))))

(defwidget slidectl [icon onchange val name headclick headtip]
  (box 
    :orientation "v"
    :space-evenly false 
    (eventbox
      :cursor {headclick == "" ? "default" : "pointer"}
      :timeout "10s"
      :tooltip headtip
      :onclick headclick
      (box 
        :orientation "h"
        :space-evenly false
        :class "window cont"
        (image 
          :image-width 35
          :path icon)
        (label 
          :text name)))
    (overlay
      (scale 
        :value val
        :onchange onchange)
      (box 
        :halign "start"
        :valign "start"
        :style "margin: 4px;"
        :class "triangle topleft")
      (box 
        :halign "end"
        :valign "end"
        :style "margin: 4px;"
        :class "triangle bottomright"))))
   
(defwidget profilectl [icon name command val auto]
  (box 
    :class "window cont"
    :orientation "h"
    :space-evenly false 
    (eventbox
      :cursor "pointer"
      :hexpand true
      :timeout "10s"
      :tooltip "${auto == "true" ? "Auto: saver on battery, performance on AC. Click to disable." : "Auto off. Click to enable."}"
      :onclick command
      (box 
        :orientation "h"
        :space-evenly false
        (image 
          :image-width 35
          :path icon)
        (label 
          :text name)
        (revealer
          :reveal {auto == "true"}
          :transition "slideleft"
          (label
            :class "auto-tag"
            :text "AUTO"))))
    (eventbox
      :cursor {auto == "true" ? "default" : "pointer"}
      :timeout "10s"
      :tooltip {auto == "true" ? "Auto is on: profile follows the charger. Click the profile name to turn auto off." : "Click to cycle profile"}
      :onclick {auto == "true" ? "true" : "setsid -f /home/rootgin/.config/eww/Phobos-dev/scripts/powerprofile.sh cycle"}
      (overlay
        (box
          :class "tri p${val} ${auto == "true" ? "dim" : ""}"
          (box 
            :width 30
            :class "knob"))
        (box 
          :halign "start"
          :valign "start"
          :style "margin: 4px;"
          :class "triangle topleft")
        (box 
          :halign "end"
          :valign "end"
          :style "margin: 4px;"
          :class "triangle bottomright")))))

(defwidget togglectl [icon name command val]
  (box 
    :class "window cont"
    :orientation "h"
    :space-evenly false 
    (image 
      :image-width 35 
      :path icon)
    (label 
      :text name)
    (box 
      :hexpand true)
    (eventbox
      :cursor "pointer"
      :onclick command
      (overlay
        (box
          :class "switch ${val ? 'on' : 'off'}"
          (box 
            :width 30
            :class "knob"))
          ; (box 
          ;   :class "switchbg"
          ;   :hexpand true))
        (box 
          :halign "start"
          :valign "start"
          :style "margin: 4px;"
          :class "triangle topleft")
        (box 
          :halign "end"
          :valign "end"
          :style "margin: 4px;"
          :class "triangle bottomright")))))
        
    
