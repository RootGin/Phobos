(defvar revealsystemint false)
(defvar sysect 0)

(defwindow systemint 
  :geometry (geometry
              :x 0 
              :y -63 
              :width 0
              :height 70
              :anchor "bottom right")
  :stacking "overlay"
  :exclusive false 
  :monitor '["<primary>", 0]'
  (box 
    :orientation "v"
    :space-evenly false 
    :height 70
    (revealer 
      :halign "end"
      :reveal revealsystemint
      :transition "slideleft"
        (box 
          :orientation "v"
          :space-evenly false
          :style "margin-left: 20px;"

          (box 
            :height 20
            :orientation "h"
            :space-evenly false 
            (box 
              :orientation "v"
              :space-evenly false 
              (box 
                :class "triangle bottomright")
              (box 
                :class "window"
                :vexpand true))
            (box 
              :class "window"
              :hexpand true))

          (box
            :class "window"
            (box 
              :style "margin: -20px 0px;"
              (systemwid)))))

    (bottomrightstruct)))
          

(defwidget systemwid []
  (box 
    :orientation "v"
    :space-evenly false 
    :width 404
    :vexpand true 
    :class "window cont trans"
    (sysecthead)
    (sysectbody)
    (slidectl
      :icon {volumejson.volumemute ? "./assets/icons/volumemute.svg" : "./assets/icons/volume.svg"}
      :val "${volumejson.volume}"
      :name "Volume"
      :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%")
    (slidectl
      :icon "./assets/icons/sun.svg"
      :val brightness
      :name "Brightness"
      :onchange "brightnessctl set {}%")
    (wifinav 
      :icon {wifi.connected ? "./assets/icons/wifi.svg" : (wifi.state == "airplane-mode" || wifi.state == "no-interface" ? "./assets/icons/wifioff.svg" : "./assets/icons/wifi.svg")}
      :label {wifi.connected ? wifi.ssid : "Wifi"}
      :state {wifi.state}
      :on {wifi.radio == "enabled"})
    (togglectl 
      :icon "./assets/icons/bluetooth.svg"
      :val {bluetooth != "disabled"} 
      :name "Bluetooth"
      :command "./scripts/bluetooth.sh --toggle")
    (profilectl
      :icon {powerprofile == "power-saver" ? "./assets/icons/pp-save.svg" : (powerprofile == "performance" ? "./assets/icons/pp-perf.svg" : "./assets/icons/pp-balance.svg")}
      :val {powerprofile == "power-saver" ? 0 : (powerprofile == "performance" ? 2 : 1)}
      :auto powerauto
      :name {powerprofile == "power-saver" ? "Power saver" : (powerprofile == "performance" ? "Performance" : "Balanced")}
      :command "setsid -f /home/rootgin/.config/eww/Phobos-dev/scripts/powerprofile.sh auto")
    (togglectl 
      :icon "./assets/icons/bell.svg"
      :val {dnd == "false"} 
      :name "Notifications"
      :command "setsid -f /home/rootgin/.config/eww/Phobos-dev/scripts/dunstctl.sh set-paused toggle")))

(defwidget sysecthead []
  (box
    :class "window cont"
    :orientation "h"
    :space-evenly false
    (image
      :image-width 35
      :path "./assets/icons/sliders.svg")
    (label
      :text {sysect == 0 ? "Section 0" : (sysect == 1 ? "Section 1" : "Section 2")})
    (box
      :hexpand true)
    (eventbox
      :cursor "pointer"
      :onclick "${EWW_CMD} update sysect=${(sysect + 2) % 3}"
      (image
        :image-width 25
        :path "./assets/icons/chevron-left.svg"))
    (eventbox
      :cursor "pointer"
      :onclick "${EWW_CMD} update sysect=${(sysect + 1) % 3}"
      (image
        :image-width 25
        :path "./assets/icons/chevron-right.svg"))))

(defwidget sysectbody []
  (box
    :class "window cont"
    :orientation "v"
    :space-evenly false
    (box
      :visible {sysect == 0}
      (label
        :text "Section 0"))
    (box
      :visible {sysect == 1}
      (label
        :text "Section 1"))
    (box
      :visible {sysect == 2}
      (label
        :text "Section 2"))))

(defwidget wifinav [icon label state on]
  (box
    :class "window cont wifinav ${state}"
    :orientation "h"
    :space-evenly false
    (eventbox
      :cursor "pointer"
      :hexpand true
      :onclick "./scripts/hackslide.sh systemint close & ${EWW_CMD} open network &"
      (box
        :orientation "h"
        :space-evenly false
        (image :image-width 35 :path icon)
        (label :truncate true :limit-width 20 :text label)))
    (box
      :hexpand true)
    (eventbox
      :cursor "pointer"
      :onclick {on ? "nmcli radio wifi off" : "nmcli radio wifi on"}
      (overlay
        (box
          :class "switch ${on ? 'on' : 'off'}"
          (box :width 30 :class "knob"))
        (box :halign "start" :valign "start" :style "margin: 4px;" :class "triangle topleft")
        (box :halign "end" :valign "end" :style "margin: 4px;" :class "triangle bottomright")))))

(defwidget slidectl [icon onchange val name]
  (box 
    :orientation "v"
    :space-evenly false 
    (box 
      :orientation "h"
      :space-evenly false
      :class "window cont"
      (image 
        :image-width 35
        :path icon)
      (label 
        :text name))
    (overlay
      (scale 
        :value val
        :onchange onchange)
      (box 
        :halign "start"
        :valign "start"
        :style "margin: 4px;"
        :class "triangle topleft")
      (box 
        :halign "end"
        :valign "end"
        :style "margin: 4px;"
        :class "triangle bottomright"))))
   
(defwidget profilectl [icon name command val auto]
  (box 
    :class "window cont"
    :orientation "h"
    :space-evenly false 
    (eventbox
      :cursor "pointer"
      :hexpand true
      :timeout "10s"
      :tooltip "${auto == "true" ? "Auto: saver on battery, performance on AC. Click to disable." : "Auto off. Click to enable."}"
      :onclick command
      (box 
        :orientation "h"
        :space-evenly false
        (image 
          :image-width 35
          :path icon)
        (label 
          :text name)
        (revealer
          :reveal {auto == "true"}
          :transition "slideleft"
          (label
            :class "auto-tag"
            :text "AUTO"))))
    (eventbox
      :cursor {auto == "true" ? "default" : "pointer"}
      :timeout "10s"
      :tooltip {auto == "true" ? "Auto is on: profile follows the charger. Click the profile name to turn auto off." : "Click to cycle profile"}
      :onclick {auto == "true" ? "true" : "setsid -f /home/rootgin/.config/eww/Phobos-dev/scripts/powerprofile.sh cycle"}
      (overlay
        (box
          :class "tri p${val} ${auto == "true" ? "dim" : ""}"
          (box 
            :width 30
            :class "knob"))
        (box 
          :halign "start"
          :valign "start"
          :style "margin: 4px;"
          :class "triangle topleft")
        (box 
          :halign "end"
          :valign "end"
          :style "margin: 4px;"
          :class "triangle bottomright")))))

(defwidget togglectl [icon name command val]
  (box 
    :class "window cont"
    :orientation "h"
    :space-evenly false 
    (image 
      :image-width 35 
      :path icon)
    (label 
      :text name)
    (box 
      :hexpand true)
    (eventbox
      :cursor "pointer"
      :onclick command
      (overlay
        (box
          :class "switch ${val ? 'on' : 'off'}"
          (box 
            :width 30
            :class "knob"))
          ; (box 
          ;   :class "switchbg"
          ;   :hexpand true))
        (box 
          :halign "start"
          :valign "start"
          :style "margin: 4px;"
          :class "triangle topleft")
        (box 
          :halign "end"
          :valign "end"
          :style "margin: 4px;"
          :class "triangle bottomright")))))
        
    
