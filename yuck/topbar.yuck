
(defwindow topbar 
  :geometry (geometry 
              :x 0
              :y 0
              :width "100%"
              :height 0
              :anchor "top center")
  :stacking "bottom"
  :exclusive true 
  :monitor '["<primary>", 0]'
  :wm-ignore false
  (topbarstruct))

(defwidget topbarstruct [] 
  (revealer
    :reveal {revealbar == 1}
    :transition "slidedown"
    (box
      :orientation "h"
      :space-evenly false
      :class "barheight"
      (topleftstruct)
      (box 
        :orientation "h"
        :space-evenly false 
        :class "window bar tb-gap"
        :hexpand true
        (label 
          :visible false
          :text "${playerctl} ${pcover} ${inputpipe} ${wifi} ${battjson}"))
      (box
        :orientation "v"
        :space-evenly false
        (box
          :class "window"
          :vexpand true)
        (box 
          :class "triangle topright"))
      (box 
        :orientation "h"
        :space-evenly false 
        :spacing 20
        :class "window bar"
        :tooltip "${battjson.tip}"
(revealer
          :transition "slideleft"
          :reveal {trayopen == "true"}
          (box
            :orientation "h"
            :space-evenly false
            :spacing 8
            :class "tray-tasks"
            :valign "center"
            (for t in {tasklistjson}
              (eventbox
                :cursor "pointer"
                :tooltip {t.name}
                :onclick "niri msg action focus-window --id ${t.id}"
                (image
                  :class "tray-task"
                  :image-width 22
                  :path {t.path})))))
        (eventbox
          :cursor "pointer"
          :timeout "10s"
          :tooltip "Running tasks"
          :onclick "./scripts/tray.sh &"
          (transform
            :transform-origin-x "50%"
            :transform-origin-y "50%"
            :rotate {trayspin * 20}
            (image
              :image-width 24
              :path "./assets/icons/tray.svg")))
(eventbox
        :cursor "pointer"
        :timeout "10s"
        :tooltip "${battjson.tip}"
        :onclick "./scripts/hackslide.sh battint &"
        (batticon))
        (eventbox
          :cursor "pointer"
          :timeout "10s"
          :tooltip "Click to swap time / date"
          :onclick "./scripts/clockswap.sh &"
          (box
            :orientation "h"
            :space-evenly false
            :valign "center"
            :class "animtime"
            (revealer
              :transition "slideleft"
              :reveal {showdate == "false"}
              (box
                :orientation "h"
                :space-evenly false
                (animdigit 
                  :class "hard large"
                  :cur {substring(formattime(EWW_TIME, '%H'), 0, 1)})
                (animdigit 
                  :class "hard large"
                  :cur {substring(formattime(EWW_TIME, '%H'), 1, 1)})
                (label 
                  :class "hard large"
                  :text ":")
                (animdigit  
                  :class "hard large"
                  :cur {substring(formattime(EWW_TIME, '%M'), 0, 1)})
                (animdigit
                  :class "hard large"
                  :cur {substring(formattime(EWW_TIME, '%M'), 1, 1)})))
            (revealer
              :transition "slideleft"
              :reveal {showdate == "true"}
              (label 
                :class "large"
                :text {formattime(EWW_TIME, '%-d/%-m/%Y')}))))))))

(defwidget topleftstruct [] 
  (box 
    :orientation "h"
    :space-evenly false 
    :vexpand true
    (box 
      :class "window bar barheight"
      :orientation "h"
      :space-evenly false
      (revealer 
        :reveal {playerctl.song == ""}
        :transition "slideright"
        (label 
          :class "large"
          :text "PHOBOS v${version}"))
      (revealer 
        :reveal {playerctl.song != ""}
        :transition "slideleft"
        (eventbox
          :cursor "pointer"
          :width 400
          :onclick "./scripts/hackslide.sh mediaint &"
          (box 
            :orientation "h"
            :hexpand true
            :space-evenly false
            (image 
              :image-width 35 
              :path "./assets/icons/libmedia.svg")
            (scroll 
              :hscroll true 
              :hexpand true
              (label 
                :class "large"
                :truncate true
                :text {playerctl.song}))))))
    (box
      :orientation "v"
      :space-evenly false
      (box
        :class "window"
        :vexpand true)
      (box 
        :class "triangle topleft"))))
(defwidget animdigit [cur class]
  (stack 
    :selected cur
    :transition "slidedown"
    (label :class class :text 0)
    (label :class class :text 1)
    (label :class class :text 2)
    (label :class class :text 3)
    (label :class class :text 4)
    (label :class class :text 5)
    (label :class class :text 6)
    (label :class class :text 7)
    (label :class class :text 8)
    (label :class class :text 9)))
