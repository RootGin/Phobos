(defvar revealbattint false)

(defwindow battint
  :geometry (geometry
              :x 0
              :y 0
              :width 0
              :height 280
              :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :monitor '["<primary>", 0]'
  (box
    :orientation "h"
    :space-evenly false
    :halign "end"
    (revealer
      :halign "end"
      :reveal revealbattint
      :transition "slideleft"
      (battwid))))

(defwidget batticon []
  (image
    :image-width 35
    :path "./assets/icons/bat${ EWW_BATTERY.BAT0.status != 'Discharging' ? 'c' : (EWW_BATTERY.BAT0.capacity < 25 ? '0' : (EWW_BATTERY.BAT0.capacity < 50 ? '1' : (EWW_BATTERY.BAT0.capacity < 75 ? '2' : '3'))) }.svg"))

(defwidget battsegs []
  (box
    :class "batt-segs"
    :orientation "h"
    :space-evenly false
    (for seg in {battjson.segments}
      (box
        :hexpand true
        :class "batt-seg ${seg}"))))

(defwidget batthero []
  (box
    :class "batt-hero"
    :orientation "v"
    :space-evenly false
    (box
      :orientation "h"
      :space-evenly false
      :valign "center"
      (label
        :class "batt-pct"
        :text "${battjson.main.charge}")
      (box
        :hexpand true)
      (label
        :class "batt-model"
        :truncate true
        :limit-width 14
        :text "${battjson.main.model}"))
    (box
      :orientation "h"
      :space-evenly false
      :valign "center"
      (label
        :class "batt-state"
        :text "${battjson.main.state}"))
    (battsegs)))

(defwidget battfact [name value]
  (box
    :class "batt-fact"
    :orientation "v"
    :space-evenly false
    :hexpand true
    (label
      :class "batt-fact-name"
      :xalign 0
      :text name)
    (label
      :class "batt-fact-val"
      :xalign 0
      :text value)))

(defwidget battfacts []
  (box
    :class "batt-facts"
    :orientation "v"
    :space-evenly false
    :spacing 3
    (box
      :orientation "h"
      :space-evenly false
      :hexpand true
      :spacing 4
      (battfact
        :name "Time left"
        :value "${battjson.main.time}")
      (battfact
        :name "Draw"
        :value "${battjson.main.draw}"))
    (box
      :orientation "h"
      :space-evenly false
      :hexpand true
      :spacing 4
      (battfact
        :name "Health"
        :value "${battjson.main.health}")
      (battfact
        :name "Cycles"
        :value "${battjson.main.cycles}"))))

(defwidget battextra [name model charge state]
  (box
    :class "batt-extra"
    :orientation "h"
    :space-evenly false
    (image
      :image-width 20
      :path "./assets/icons/bat${ charge == "100%" || state == "Full" ? 'c' : (state == "Charging" ? 'c' : '1') }.svg")
    (label
      :class "batt-extra-name"
      :truncate true
      :limit-width 11
      :text model)
    (box
      :hexpand true)
    (label
      :class "batt-extra-val"
      :truncate true
      :limit-width 18
      :text "${charge} · ${state}")))

(defwidget battextras []
  (box
    :class "batt-extras"
    :orientation "v"
    :space-evenly false
    :visible {battjson.extra != []}
    (for bat in {battjson.extra}
      (battextra
        :name "${bat.name}"
        :model {bat.model != "" ? bat.model : bat.name}
        :charge "${bat.charge}"
        :state "${bat.state}"))))

(defwidget battslider []
  (box
    :class "batt-slider"
    :orientation "h"
    :space-evenly false
    :valign "center"
    (scale
      :class "batt-scale"
      :value "${battjson.thr}"
      :min 0
      :max 40
      :onchange "./scripts/battery.py threshold {}")))

(defwidget battopts []
  (box
    :class "batt-opts"
    :orientation "v"
    :space-evenly false
    (label
      :class "batt-sect"
      :xalign 0
      :text "Options")
    (box
      :orientation "v"
      :space-evenly false
      (box
        :orientation "h"
        :space-evenly false
        :valign "center"
        (label
          :class "batt-opt-name"
          :xalign 0
          :text "Low-battery alert")
        (box
          :hexpand true)
        (label
          :class "batt-thr"
          :text "${battjson.thr}%"))
      (battslider))))

(defwidget battwid []
  (box
    :class "batt-card"
    :orientation "v"
    :space-evenly false
    (batthero)
    (battfacts)
    (battextras)
    (battopts)))
