;; Notifications — end-rs widgets, restyled for Phobos (Nord + triangle chamfers).
;; Regenerating with `end-rs generate all` overwrites this; re-apply the changes below
;; or keep them in a post-generate patch. The window/widget/var names must stay in sync
;; with ~/.config/end-rs/config.toml.

(defvar end-binary "end-rs")
(defvar end-notifications '')
(defvar end-histories '')
(defvar end-replies '')

(defwindow notification-frame
  :monitor 0
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "450px"
    :height "0px"
    :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :windowtype "dialog"
  :passthrough true
  :wm-ignore true
  (literal :content end-notifications))

(defwindow history-frame
  :monitor 0
  :class "end-history-frame"
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "450px"
    :height "0px"
    :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :windowtype "dialog"
  :passthrough true
  :wm-ignore true
  (scroll :hscroll false :vscroll true (literal :content end-histories)))

(defwidget end-notification[notification]
  (eventbox
    :onclick "${end-binary} close ${notification.id}"
    :valign "start"
    (box
      :class `end-noti-box-${notification.urgency}`
      (overlay
        (box
          :class "end-noti-card"
          :orientation "vertical"
          :space-evenly false
          (box
            :class "end-noti-header"
            :orientation "horizontal"
            :space-evenly false
            (image
              :path {notification.app_icon}
              :class "end-noti-appicon"
              :image-width 18
              :image-height 18)
            (label
              :class "end-noti-appname"
              :valign "start"
              :yalign 0
              :xalign 0
              :text {notification.application}))
          (box
            :class "end-noti-body"
            :orientation "horizontal"
            :space-evenly false
            (image
              :path {notification.icon}
              :image-width 44
              :image-height 44
              :class "end-noti-image")
            (box
              :class "end-noti-content"
              :valign "start"
              :orientation "vertical"
              :space-evenly false
              (label
                :class "end-noti-text end-noti-summary"
                :valign "start"
            :yalign 0
            :xalign 0
            :wrap true
            :truncate true
            :markup {notification.summary})
          (label
            :class "end-noti-text end-noti-body-text"
            :valign "start"
            :yalign 0
            :xalign 0
            :vexpand true
            :wrap true
            :limit-width 52
            :lines 3
            :markup {notification.body})))
        (box
          :class "end-noti-buttons"
          :orientation "horizontal"
          :space-evenly false
          :valign "end"
          :vexpand false
          (for action in {notification.actions}
            (eventbox
              :cursor "pointer"
              :class "end-noti-button"
              :onclick "${end-binary} action ${notification.id} ${action.id}"
              (label :text {action.text})))))
      (box :class "end-noti-wedge topleft" :halign "start" :valign "start")
      (box :class "end-noti-wedge bottomright" :halign "end" :valign "end")))))

(defwidget end-history[history]
  (eventbox
    :onclick "${end-binary} history close"
    (box
      :class "end-history-box"
      (overlay
        (box
          :class "end-history-card"
          :orientation "vertical"
          :space-evenly false
          (box
            :class "end-history-title-bar"
            :orientation "horizontal"
            :space-evenly false
            (image
              :path {history.app_icon}
              :class "end-noti-appicon"
              :image-width 15
              :image-height 15)
            (label
              :class "end-noti-appname"
              :valign "start"
              :yalign 0
              :xalign 0
              :text {history.app_name}))
          (box
            :class "end-history-body-box"
            :orientation "horizontal"
            :space-evenly false
            (image
              :path {history.icon}
              :image-width 44
              :image-height 44
              :class "end-noti-image")
            (box
              :class "end-noti-content"
              :orientation "vertical"
              :space-evenly false
              (label
                :class "end-noti-text end-noti-summary"
                :yalign 1
                :xalign 0
                :wrap true
                :truncate true
                :markup {history.summary})
              (label
                :class "end-noti-text end-noti-body-text"
                :yalign 1
                :xalign 0
                :wrap true
                :truncate true
                :markup {history.body})))
        (box :class "end-noti-wedge hist topleft" :halign "start" :valign "start")
        (box :class "end-noti-wedge hist bottomright" :halign "end" :valign "end"))))))
