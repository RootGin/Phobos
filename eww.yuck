(defvar version "0.4.66")

(defvar EWW_CMD "eww -c .")

(defpoll volumejson :interval "2s" "./scripts/volume-status.sh")
(deflisten brightness :initial "0" "./scripts/brightness-watch.sh")
(defvar sysstat '{"cpu":0,"ram":0}')
(defvar diskstat "0")
(defvar vpnt '{"state":"off","server":"","ip":""}')
(deflisten wifi :initial '{"iface":"","radio":"enabled","state":"disconnected","ssid":"","security":"","signal":0,"bucket":"very-weak","connected":false,"connecting":false,"networks":[]}' "./scripts/wifi.py")
(deflisten btsec :initial '{"powered":false,"adapter":"","discovering":false,"devices":[]}'
  "./scripts/btsec.py stream")
(deflisten dnd :initial "false" "./scripts/dunstctl.sh is-paused")
(defvar showdate "false")
(defpoll powerprofile :interval "10s" "powerprofilesctl get 2>/dev/null || echo balanced")
(deflisten powerauto :initial "false" "./scripts/powerprofile.sh emit-auto")

(deflisten battjson :initial '{"thr":20,"ac":false,"main":{"name":"","cap":0,"present":false,"state":"","charge":"","time":"","draw":"","health":"","cycles":"","model":""},"extra":[],"segments":[],"brief":"","tip":""}' "./scripts/battery.py")

(deflisten pcover "./scripts/coverart.sh")
(deflisten playerctl :initial '{"song": "", "artist": "", "status": "Stopped"}' "playerctl metadata --format '{\"song\": \"{{title}}\",\"artist\": \"{{artist}}\", \"status\": \"{{status}}\"}' -F")

(defvar windowsjson "[[], [], [], [], []]")

(deflisten workspacejson 
  :initial '{"workspaces": [{"focused": true, "empty": false, "name": 1}, {"focused": false, "empty": true, "name": 2}, {"focused": false, "empty": true, "name": 3}, {"focused": false, "empty": true, "name": 4}, {"focused": false, "empty": true, "name": 5}], "focused": 0}'
  "./scripts/tasklist.py")

(defvar tasklistjson "[]")

(deflisten appsjson :initial '{"apps": []}' "./scripts/apps.py")

(deflisten anim :initial 0 "python ./scripts/anim.py")

(deflisten inputpipe :initial "ready" "./scripts/helper/input-buffer.sh")

(defvar revealbar 1)

(include "./yuck/topbar.yuck")
(include "./yuck/bottombar.yuck")
(include "./yuck/tasklist.yuck")
(include "./yuck/launcher.yuck")
(include "./yuck/system.yuck")
(include "./yuck/network.yuck")
(include "./yuck/bt.yuck")
(include "./yuck/osd.yuck")
(include "./yuck/barslide.yuck")
(include "./yuck/media.yuck")
(include "./yuck/battery.yuck")
(include "./yuck/powermenu.yuck")
(include "./yuck/util.yuck")

